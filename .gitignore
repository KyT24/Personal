# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Diagnostic reports (for Node.js)
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Directory for instrumented libs generated by jscoverage/JSCover
lib-cov

# Coverage directory used by tools like istanbul
coverage
*.lcov

# nyc test coverage
.nyc_output

# Grunt string build cache
.grunt

# Bower dependency directory (deprecated, but safe to keep)
bower_components

# node-modules
node_modules/
jspm_packages/

# Snowpack dependency directory (http://snowpack.dev)
web_modules/

# TypeScript cache
*.tsbuildinfo

# Optional npm cache directory
.npm

# Output directory generated by Vite (production build)
dist/
dist-ssr/

# IDEs and editors
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store

# Local environment files (CRITICAL: Shields your API keys/secrets)
.env
.env.local
.env.[a-zA-Z0-9]*
!.env.example

# Vercel deployment metadata
.vercel
